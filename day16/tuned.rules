alert dns $HOME_NET any -> any any (msg:"LAB Phishing domain lookup"; dns.query; content:"secure-invoice-review.example"; nocase; classtype:trojan-activity; sid:1000001; rev:1;)
alert http $HOME_NET any -> any any (msg:"LAB payload.bin download"; flow:established,to_server; http.uri; content:"/payload.bin"; classtype:trojan-activity; sid:1000002; rev:1;)
alert tcp $HOME_NET any -> 198.51.100.77 443 (msg:"LAB Connection to known C2 IP"; flags:S; threshold:type limit, track by_src, count 1, seconds 3600; classtype:trojan-activity; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB Possible SYN port scan"; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)
alert dns $HOME_NET any -> any any (msg:"LAB Long DNS label possible tunneling"; dns.query; pcre:"/^[a-z0-9]{30,}\./i"; classtype:bad-unknown; sid:1000005; rev:1;)
